create or replace function public.get_accountability_matrix(p_org uuid)
returns table (
  committee_id   uuid,
  committee_name text,
  member_count   bigint,
  total_tasks    bigint,
  todo           bigint,
  in_progress    bigint,
  done           bigint,
  overdue        bigint,
  last_activity  timestamptz
)
language sql stable security definer set search_path = public as $$
  select
    c.id,
    c.name,
    count(distinct m.user_id),
    count(t.id),
    count(t.id) filter (where t.status = 'todo'),
    count(t.id) filter (where t.status = 'in_progress'),
    count(t.id) filter (where t.status = 'done'),
    count(t.id) filter (where t.status <> 'done' and t.due_date < current_date),
    max(t.updated_at)
  from public.committees c
  left join public.organization_members m
         on m.committee_id = c.id
        and m.organization_id = c.organization_id
  left join public.tasks t on t.user_id = m.user_id
  where c.organization_id = p_org
    and (
      public.is_org_leadership(p_org)
      or exists (
        select 1 from public.organization_members me
        where me.organization_id = p_org
          and me.user_id = auth.uid()
          and me.role = 'Committee Head'
          and me.committee_id = c.id
      )
    )
  group by c.id, c.name
  order by c.name;
$$;

revoke all on function public.get_accountability_matrix(uuid) from public, anon;
grant execute on function public.get_accountability_matrix(uuid) to authenticated;